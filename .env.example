# Google Service Account credentials (server-side only, never exposed to the browser)
# See README.md "Google Sheets setup" for how to create these.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the full private key from the downloaded JSON key file.
# Keep the quotes and \n escape sequences exactly as they appear in the JSON.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID of the Google Sheet (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=your-google-sheet-id

# ---------------------------------------------------------------------------
# WhatsApp bot (Meta WhatsApp Cloud API) — see README "WhatsApp bot".
# All server-side only. Never commit real values.
# ---------------------------------------------------------------------------

# Any long random string you invent. You type the same value into Meta's
# webhook setup screen; Meta sends it back to prove the webhook is yours.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string

# Access token used to send replies. Use a permanent System User token for
# real use (the temporary one on Meta's test page expires in ~24 hours).
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# The "Phone number ID" shown on Meta's WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Comma-separated numbers allowed to send commands, country code first.
# Spaces, + and dashes are ignored. Anyone else is silently ignored.
WHATSAPP_ALLOWED_NUMBERS=919876543210,919123456789

# Your Meta app's App Secret (App settings > Basic). Used to check that each
# webhook call really came from Meta. REQUIRED in production: without it the
# webhook refuses all messages.
WHATSAPP_APP_SECRET=your-meta-app-secret

# ---------------------------------------------------------------------------
# Phone reminders (free ntfy.sh app) — see README "Phone reminders".
# ---------------------------------------------------------------------------

# A long, hard-to-guess name you invent, e.g. vaiga-orders-k39x7qm2p81z.
# You subscribe to the same name in the ntfy phone app.
NTFY_TOPIC=vaiga-orders-change-me-to-something-random

# Any long random string. Vercel uses it to prove the schedule call is genuine.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: your live app address, so tapping the notification opens it.
APP_URL=https://your-app.vercel.app

# Optional: name shown in capital letters at the top of the notification.
APP_NAME=Vaiga Sweets & Snacks
